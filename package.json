    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "figlet": "^1.8.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^9.3.7",
    "marked": "^12.0.0",
    "marked-terminal": "^7.2.1",
