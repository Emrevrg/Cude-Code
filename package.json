{
  "name": "codiente-cli",
  "version": "1.0.0",
  "description": "Güçlü AI destekli CLI - kodlama, otomasyon ve üretkenlik",
  "bin": {
    "codiente": "./dist/index.js"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "cd renderer && npm run build",
    "build:desktop": "npm run build:electron && npm run build:renderer",
    "build:all": "npm run build && npm run build:desktop",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --win --mac --linux",
    "dev:desktop": "concurrently \"cd renderer && npm run dev\" \"wait-on http://localhost:5173 && electron dist-electron/electron/main.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "date-fns": "^3.6.0",
    "figlet": "^1.8.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^9.3.7",
    "marked": "^12.0.0",
    "marked-terminal": "^7.2.1",
    "openai": "^4.76.0",
    "ora": "^8.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.5"
  }
}
